# Copy to .env for local development. On Vercel, set these as
# Environment Variables of the project instead.

# Administration only (python manage.py apply-schema) ----------------------

# Connection string of the database owner. Used only to create the schema
# and the restricted identity_app role; never set it on Vercel.
NEON_DATABASE_URL="postgresql://<owner>:<password>@<host>.<region>.aws.neon.tech/<database>?sslmode=require"

# Required at runtime ---------------------------------------------------

# Connection string of the identity_app role, written by
# "python manage.py apply-schema". Prefer the Neon pooled host
# (contains "-pooler") for serverless deployments.
AUTH_DATABASE_URL="postgresql://identity_app:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"

# RSA private key that signs the access tokens, on one line with \n
# escapes. Generate it with: python manage.py generate-signing-key
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<...>\n-----END PRIVATE KEY-----"

# Optional (defaults shown) ---------------------------------------------

# Token identity. Client applications must check the same issuer and
# audience. Change AUTH_JWT_KEY_ID whenever the signing key is rotated.
AUTH_JWT_KEY_ID=auth-key-1
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=synapse-apps

ENVIRONMENT=development
APPLICATION_NAME=SynapseAI
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12
KEEP_SIGNED_IN_TTL_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_MINUTES=15

# Front-end page that reads "#reset_token=<token>" from the URL.
PASSWORD_RESET_URL=http://localhost:5500/reset-password.html
PASSWORD_RESET_TTL_MINUTES=30

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# "console" only logs e-mails (development). "resend" sends through the
# Resend API (needs RESEND_API_KEY and a verified RESEND_FROM domain).
# "smtp" sends through an SMTP server.
EMAIL_BACKEND=console
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
